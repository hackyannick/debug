# systemd-Dienst für den Drop-Folder-Modus auf dem Server (z. B. PowerEdge R640).
# Installation:
#   sudo cp scripts/magicbox-watch.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now magicbox-watch
[Unit]
Description=Magic Box – Drop-Folder (Datei rein, Doku raus)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
User=magicbox
WorkingDirectory=/opt/magicbox
ExecStart=/opt/magicbox/.venv/bin/magicbox watch /srv/magicbox/eingang --url http://127.0.0.1:11434
Restart=on-failure
# Analysierte Dateien sind potenziell bösartig: Dienst so weit wie möglich einsperren
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/magicbox

[Install]
WantedBy=multi-user.target
